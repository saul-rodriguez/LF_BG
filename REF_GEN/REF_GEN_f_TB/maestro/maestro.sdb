				<extensions>
					<extension>Parasitics
						<callback>_parSetupDBExtensionCB</callback>
						<iconvalue></iconvalue>
						<icontype></icontype>
					</extension>
				</extensions>
				<currentmode>Single Run, Sweeps and Corners</currentmode>
				<overwritehistory>0</overwritehistory>
				<tests>
					<test enabled="1">OP
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>REF_GEN_f_TB</value>
							</option>
							<option>lib
								<value>REF_GEN</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>config</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>Interactive.300</value>
							</option>
						</tooloptions>
						<origoptions>
							<option>cell
								<value>REF_GEN_TB</value>
							</option>
							<option>lib
								<value>BANDGAP</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic</value>
							</option>
						</origoptions>
						<outputs>
							<output>V1000
								<evalType>point</evalType>
							</output>
							<output>V550
								<evalType>point</evalType>
							</output>
							<output>I32nA
								<evalType>point</evalType>
							</output>
							<output>I128nA
								<evalType>point</evalType>
							</output>
							<output>BangapRef
								<evalType>point</evalType>
							</output>
							<output>PRN_TRIGGER
								<evalType>point</evalType>
							</output>
							<output>IDC("")
								<evalType>point</evalType>
