								<evalType>point</evalType>
							</output>
						</outputs>
						<tooloptions>
							<option>cell
								<value>REF_GEN_f_TB</value>
							</option>
							<option>lib
								<value>REF_GEN</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
