					<test enabled="1">OP
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>REF_GEN_f_TB</value>
							</option>
							<option>lib
								<value>REF_GEN</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
