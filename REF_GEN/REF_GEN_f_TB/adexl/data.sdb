								<evalType>point</evalType>
							</output>
							<output>IDC("")
								<evalType>point</evalType>
							</output>
							<output>REF5_dc_current
								<evalType>point</evalType>
							</output>
							<output>total_noise_V
								<evalType>point</evalType>
							</output>
							<output>LDO
								<units></units>
								<significantDigits>0</significantDigits>
								<notation></notation>
								<suffix></suffix>
								<evalType>point</evalType>
							</output>
