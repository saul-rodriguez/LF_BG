				<tests>
					<test enabled="1">OP
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>REF_GEN_TB</value>
							</option>
							<option>lib
								<value>BANDGAP</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>OP_none_Interactive.11</value>
							</option>
						</tooloptions>
						<origoptions>
							<option>cell
								<value>REF_GEN_TB</value>
							</option>
							<option>lib
								<value>BANDGAP</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic</value>
							</option>
						</origoptions>
						<outputs>
							<output>V1000
								<evalType>point</evalType>
							</output>
							<output>V550
								<evalType>point</evalType>
							</output>
							<output>I32nA
								<evalType>point</evalType>
							</output>
							<output>I128nA
								<evalType>point</evalType>
							</output>
							<output>BangapRef
								<evalType>point</evalType>
							</output>
							<output>PRN_TRIGGER
								<evalType>point</evalType>
							</output>
							<output>IDC("")
								<evalType>point</evalType>
							</output>
							<output>REF5_dc_current
								<evalType>point</evalType>
							</output>
							<output>total_noise_V
								<evalType>point</evalType>
							</output>
						</outputs>
					</test>
					<test enabled="1">TRAN
						<tool>ADE</tool>
						<outputs>
							<output>V1000
								<evalType>point</evalType>
