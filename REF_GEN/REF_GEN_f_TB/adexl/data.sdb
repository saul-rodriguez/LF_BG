				<tests>
					<test enabled="1">OP
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>REF_GEN_f_TB</value>
							</option>
							<option>lib
								<value>REF_GEN</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>config</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>OP_none_Interactive.89</value>
							</option>
						</tooloptions>
						<origoptions>
							<option>cell
								<value>REF_GEN_TB</value>
							</option>
							<option>lib
								<value>BANDGAP</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic</value>
							</option>
						</origoptions>
