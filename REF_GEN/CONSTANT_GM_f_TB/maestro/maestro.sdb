				<currentmode>Single Run, Sweeps and Corners</currentmode>
				<overwritehistory>0</overwritehistory>
				<tests>
					<test enabled="1">REF_GEN_CONSTANT_GM_f_TB_1
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>CONSTANT_GM_f_TB</value>
							</option>
							<option>lib
								<value>REF_GEN</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>Interactive.3</value>
							</option>
						</tooloptions>
						<vars>
							<var>EN
								<value>1.2</value>
							</var>
							<var>EN_PULSE
								<value>0</value>
