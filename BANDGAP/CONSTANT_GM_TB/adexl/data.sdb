		<extensions>
			<extension>Parasitics
				<callback>_parSetupDBExtensionCB</callback>
				<iconvalue></iconvalue>
				<icontype></icontype>
			</extension>
		</extensions>
		<currentmode>Single Run, Sweeps and Corners</currentmode>
		<overwritehistory>0</overwritehistory>
		<tests>
			<test enabled="1">BANDGAP:CONSTANT_GM_TB:1
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>CONSTANT_GM_TB</value>
					</option>
					<option>lib
						<value>BANDGAP</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>state
						<value>BANDGAP:CONSTANT_GM_TB:1_active</value>
					</option>
				</tooloptions>
				<origoptions>
					<option>cell
						<value>CONSTANT_GM_TB</value>
					</option>
					<option>lib
						<value>BANDGAP</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>state
						<value>spectre_state1</value>
					</option>
				</origoptions>
				<outputs>
					<output>i("/R0/PLUS" ?result "dcOp")
						<evalType>point</evalType>
					</output>
					<output>i("/V1/PLUS" ?result "dcOp")
						<evalType>point</evalType>
					</output>
				</outputs>
			</test>
			<test enabled="1">START_UP
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>CONSTANT_GM_TB</value>
					</option>
					<option>lib
						<value>BANDGAP</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>state
						<value>START_UP_active</value>
					</option>
				</tooloptions>
				<origoptions>
					<option>cell
						<value>CONSTANT_GM_TB</value>
					</option>
					<option>lib
						<value>BANDGAP</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic</value>
					</option>
				</origoptions>
				<outputs></outputs>
			</test>
		</tests>
		<vars>
			<var enabled="1">VDD
				<value>1.2</value>
				<dependentTests>
					<dependentTest enabled="1">BANDGAP:CONSTANT_GM_TB:1</dependentTest>
					<dependentTest enabled="1">START_UP</dependentTest>
				</dependentTests>
			</var>
			<var enabled="1">VDD_PULSE
				<value>0</value>
				<dependentTests>
					<dependentTest enabled="1" omitted="0">BANDGAP:CONSTANT_GM_TB:1</dependentTest>
					<dependentTest enabled="1">START_UP</dependentTest>
				</dependentTests>
			</var>
			<var enabled="1">EN
				<value>1.2</value>
				<dependentTests>
					<dependentTest enabled="1" omitted="0">BANDGAP:CONSTANT_GM_TB:1</dependentTest>
					<dependentTest enabled="1" omitted="0">START_UP</dependentTest>
				</dependentTests>
			</var>
			<var enabled="1">EN_PULSE
				<value>0</value>
				<dependentTests>
					<dependentTest omitted="0">BANDGAP:CONSTANT_GM_TB:1</dependentTest>
					<dependentTest enabled="1" omitted="0">START_UP</dependentTest>
				</dependentTests>
			</var>
		</vars>
		<overwritehistoryname>Interactive.0</overwritehistoryname>
		<plottingoptions>
			<plottingoption>plottingmode
				<value>Append</value>
			</plottingoption>
			<plottingoption>plottype
				<value>None</value>
			</plottingoption>
			<plottingoption>usewaveformtemplate
