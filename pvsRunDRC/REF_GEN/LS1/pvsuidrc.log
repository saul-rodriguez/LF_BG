RULE PXL.METALF.S.01 {
    CAPTION pxlMETALF spacing < 0.50 for lines with width > 1.80;
    SIZE pxlMETALF -by "1.80/2.0" -underover -outputlayer WIDE_METAL_SPACING_$0_wideLayer;
    HOLES pxlMETALF -inner -empty -outputlayer WIDE_METAL_SPACING_$0_wideLayer_w_holes;
    EXTE WIDE_METAL_SPACING_$0_wideLayer pxlMETALF -lt 0.5 -project ge 0.24 -abut lt 90 -single_point -output region -outputlayer WIDE_METAL_SPACING_$0_wideSpace;
    NOT WIDE_METAL_SPACING_$0_wideSpace WIDE_METAL_SPACING_$0_wideLayer_w_holes detect;
    NOT detect noDRC;
}

