    EXTE PCONT GATE -lt 0.1 -abut lt 90 -single_point -output region -measure all -outputlayer CLEARANCE_$17_detect;
    NOT CLEARANCE_$17_detect waiver2;
}

RULE CON.10 {
    CAPTION PCONT and DIFF not allowed to overlap;
    OR noDRC MCEL -outputlayer waiver;
    OR waiver SRAMmark -outputlayer waiver1;
    OR waiver1 PXL -outputlayer waiver2;
    AND PCONT DIFF -outputlayer NO_OVERLAP_$4_detect;
    NOT NO_OVERLAP_$4_detect waiver2;
}

RULE CONT.09 {
    CAPTION CONT vertex not located on 0.005 grid;
    OR noDRC SEALRINGmark -outputlayer waiver;
    NOT CONT waiver -outputlayer GRIDCHECK_$0_detect;
    OFFGRID GRIDCHECK_$0_detect 5;
}

RULE CONT.ARRAY {
    CAPTION CONT in array spacing < 0.16;
    SIZE CONT -by "0.16*0.5" -overunder -outputlayer VIA_ARRAY_SPACING_$0_VIA_MARK;
    SIZE VIA_ARRAY_SPACING_$0_VIA_MARK -by "0.16+0.14" -underover -outputlayer VIA_ARRAY_SPACING_$0_MIN_MARK;
    SELECT -interact VIA_ARRAY_SPACING_$0_MIN_MARK CONT -ge 9 -outputlayer VIA_ARRAY_SPACING_$0_VIA_ARRAY_MARK;
    SELECT -interact CONT VIA_ARRAY_SPACING_$0_VIA_ARRAY_MARK -outputlayer VIA_ARRAY_SPACING_$0_VIA_IN_ARRAY;
    EXTE VIA_ARRAY_SPACING_$0_VIA_IN_ARRAY VIA_ARRAY_SPACING_$0_VIA_IN_ARRAY -lt 0.16 -abut lt 90 -output region -outputlayer VIA_ARRAY_SPACING_$0_detect;
    NOT VIA_ARRAY_SPACING_$0_detect noDRC;
}

RULE VI1.01 {
    CAPTION VIA1 must be 0.15 x 0.15;
    OR noDRC SEALRINGmark -outputlayer waiver;
    RECT_CHK VIA1 -eq 0.15 -not -by "eq" 0.15 -orthogonal_only -outputlayer VIA_WIDTH_$1_detect;
    NOT VIA_WIDTH_$1_detect waiver;
