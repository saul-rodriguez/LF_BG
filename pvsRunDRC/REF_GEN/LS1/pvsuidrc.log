    NOT MINOVERLAP_$99_detect noDRC;
}

RULE BSI.SLOTSI.SLOTOX.OV.01 {
    CAPTION SLOTSI enclosure SLOTOX < 1.25;
    AND SLOTOX noDRC _EPTMPL264319;
    NOT SLOTOX BSI.SLOTSI.SLOTOX.OV.01:_EPTMPL264319 -outputlayer MINOVERLAP_$100_inpLay1;
    ENC MINOVERLAP_$100_inpLay1 SLOTSI -lt 1.25 -abut lt 90 -single_point -output region -outputlayer MINOVERLAP_$100_detect;
    NOT MINOVERLAP_$100_detect noDRC;
}

RULE DIF.02.a {
    CAPTION PDIFFNW3V3 ALLPW1V2 spacing <= 0.70;
    EXTE PDIFFNW3V3 ALLPW1V2 -le 0.7 -abut lt 90 -single_point -output region -measure all;
}

