RULE DIF.14 {
    CAPTION DIFF edge <= 0.11, the adjacent DIFF edge has to be >= 0.135;
    NOT DIFF noDRC -outputlayer OPC_AWARE_$0_inputLayer1;
    CONVEX_EDGE OPC_AWARE_$0_inputLayer1 -angle1 lt 180 -length1 lt 0.135 -angle2 gt 0 -with_length le 0.11 -outputlayer OPC_AWARE_$0__CPTMPL1644;
    EDGE_EXPAND OPC_AWARE_$0__CPTMPL1644 -outside_by 0.001 -inside_by 0.001 -extend_by 0.001 -outputlayer OPC_AWARE_$0_detect1;
    CONVEX_EDGE OPC_AWARE_$0_inputLayer1 -angle1 gt 180 -length1 lt 0.135 -angle2 gt 0 -with_length le 0.11 -outputlayer OPC_AWARE_$0__CPTMPL1646;
    EDGE_EXPAND OPC_AWARE_$0__CPTMPL1646 -outside_by 0.001 -inside_by 0.001 -extend_by 0.001 -outputlayer OPC_AWARE_$0_detect2;
    CONVEX_EDGE OPC_AWARE_$0_inputLayer1 -angle1 lt 180 -length1 le 0.11 -angle2 gt 0 -with_length lt 0.135 -outputlayer OPC_AWARE_$0__CPTMPL1648;
    EDGE_EXPAND OPC_AWARE_$0__CPTMPL1648 -outside_by 0.001 -inside_by 0.001 -extend_by 0.001 -outputlayer OPC_AWARE_$0_detect3;
    CONVEX_EDGE OPC_AWARE_$0_inputLayer1 -angle1 gt 180 -length1 le 0.11 -angle2 gt 0 -with_length lt 0.135 -outputlayer OPC_AWARE_$0__CPTMPL1650;
    EDGE_EXPAND OPC_AWARE_$0__CPTMPL1650 -outside_by 0.001 -inside_by 0.001 -extend_by 0.001 -outputlayer OPC_AWARE_$0_detect4;
    OR OPC_AWARE_$0_detect1 OPC_AWARE_$0_detect2 -outputlayer OPC_AWARE_$0__CPTMPL1652;
    OR OPC_AWARE_$0_detect3 OPC_AWARE_$0_detect4 -outputlayer OPC_AWARE_$0__CPTMPL1653;
    OR OPC_AWARE_$0__CPTMPL1652 OPC_AWARE_$0__CPTMPL1653 -outputlayer OPC_AWARE_$0_detect;
