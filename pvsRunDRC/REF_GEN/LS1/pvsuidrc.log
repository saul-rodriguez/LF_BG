RULE CON.01 {
    CAPTION CONT must be 0.14 x 0.14;
    OR noDRC MCEL -outputlayer waiver;
    OR waiver SRAMmark -outputlayer waiver1;
    OR waiver1 SEALRINGmark -outputlayer waiver2;
    OR waiver2 YMUXmark -outputlayer waiver3;
    RECT_CHK CONT -eq 0.14 -not -by "eq" 0.14 -orthogonal_only -outputlayer VIA_WIDTH_$0_detect;
    NOT VIA_WIDTH_$0_detect waiver3;
}

RULE CON.02 {
    CAPTION CONT spacing < 0.16;
    OR noDRC MCEL -outputlayer waiver;
    OR waiver YMUXmark -outputlayer waiver1;
    EXTE CONT CONT -lt 0.16 -abut lt 90 -single_point -output region -outputlayer SPACING_$13_detect;
    NOT SPACING_$13_detect waiver1;
}

RULE CON.03.SRAM.a {
